# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Backend
node_modules/
supabase/.temp/
supabase/.branches/

# Secrets. The Meta app secret and access tokens must never be committed.
.env
.env.*
!.env.example

# The Flutter application's configuration, passed with --dart-define-from-file.
# The publishable key in it is safe in a browser — row level security is what
# protects the data — but keeping it out means rotating a key is not a commit.
env.json
