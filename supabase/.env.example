# Copy to .env and fill in. Never commit the real values.
#
# Apply to the deployed function with:
#   supabase secrets set --env-file supabase/.env

# From the Meta app dashboard, under App Settings > Basic.
# Signs every webhook delivery. Without it the function rejects every POST,
# because it cannot tell a real delivery from a forged one.
META_APP_SECRET=

# A random string we choose. Meta echoes it back during the verification
# handshake to prove the endpoint is ours. Any long random value will do:
#   openssl rand -hex 32
META_VERIFY_TOKEN=

# Note: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are not listed here on
# purpose. Supabase injects them into deployed functions automatically, and
# refuses to accept any secret whose name starts with SUPABASE_. They are only
# needed as real environment variables when running a function locally with
# `supabase functions serve`.
